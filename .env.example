LANGSMITH_API_KEY=
GOOGLE_API_KEY=
LANGSMITH_PROJECT=kyc-compliance-agent
# Hugging Face id or local folder of the fine-tuned GLiNER2 PII model; "off" = regex reader only
PII_MODEL=VK1402/AADHAAR_Extractor
PII_THRESHOLD=0.30
# retrieve_rules: the Directions PDF (see data/SOURCE.md), where Chroma persists, which Gemini embedding model
RBI_PDF_PATH=data/rbi_nbfc_kyc_directions_2025_from_html.pdf
CHROMA_DIR=data/chroma
EMBEDDING_MODEL=gemini-embedding-001
RETRIEVAL_K=3
# decide: "llm" (Gemini Flash, structured output, temperature 0), "agent" (Gemini chooses tools: search_rbi_rules,
# check_kyc_due, compare_across_documents; max 5 calls) or "rules" (plain-code baseline only)
DECIDE_MODE=llm
GEMINI_MODEL=gemini-2.5-flash-lite
# 0 switches Gemini's thinking off (cheaper, faster); "none" leaves the model default
GEMINI_THINKING_BUDGET=0
